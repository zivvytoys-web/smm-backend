# Environment Settings
PROJECT_NAME="Social AI Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DB="social_ai_db"
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/social_ai_db"
# Railway also provides MYSQL_URL for its MySQL service; the backend uses it
# automatically when DATABASE_URL is not set.

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Vercel preview/production URLs are allowed by the default regex. To restrict
# production to one site, set both values in Railway, for example:
# BACKEND_CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=""

# Optional first administrator. Set these only as Railway service variables;
# passwords are deliberately not committed to source control.
SEED_DEFAULT_ADMIN=False
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_ADMIN_NAME="System Administrator"

# AI Engine: Unified Google Gemini API Key for Text, Image, and Video (Veo)
GEMINI_API_KEY=""  # Required: Single Google AI key from https://aistudio.google.com/app/apikey
GEMINI_TEXT_MODEL="gemini-3.1-flash-lite"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
GEMINI_VIDEO_MODEL="veo-3.1-fast-generate-preview"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
STABILITY_API_KEY=""

# Social Platforms API Credentials
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Storage (Cloudinary, AWS S3, or Local)
STORAGE_TYPE="cloudinary" # 'cloudinary', 's3', or 'local'
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="social-ai-platform-assets"
LOCAL_STORAGE_DIR="./uploads"

# Payment (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
